<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".Holder.Statements">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <TextView
            android:id="@+id/toolbar_title"
            style="@style/Widget.PManager.ToolbarTitle"
            android:text="Rent statement" />
    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/filter_card_margin"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/teal_wash"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/filter_card_padding">

            <TextView
                style="@style/Widget.PManager.FilterLabel"
                android:text="Choice" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_choice_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnChoiceStatements"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice_segment"
                    android:gravity="center"
                    android:text="Statements"
                    android:textColor="@color/choice_segment_text"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btnChoiceDebts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice_segment"
                    android:gravity="center"
                    android:text="Debt Summary"
                    android:textColor="@color/choice_segment_text"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:text="Property" />

                    <Spinner
                        android:id="@+id/spnprty"
                        style="@style/Widget.PManager.FilterSpinner" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tenantFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:text="Tenant" />

                    <Spinner
                        android:id="@+id/spntt"
                        style="@style/Widget.PManager.FilterSpinner" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:text="Select" />

                    <Spinner
                        android:id="@+id/spntype"
                        style="@style/Widget.PManager.FilterSpinner" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:text="Action" />

                    <Spinner
                        android:id="@+id/spnacton"
                        style="@style/Widget.PManager.FilterSpinner" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:text="Start" />

                    <EditText
                        android:id="@+id/datestt"
                        style="@style/Widget.PManager.FilterField"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:hint="From" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:text="End" />

                    <EditText
                        android:id="@+id/datend"
                        style="@style/Widget.PManager.FilterField"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:hint="To" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/teal_800"
                android:textSize="12sp"
                android:text="Choose Statements or Debt Summary." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJournal"
        style="@style/Widget.PManager.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/filter_card_margin"
        android:layout_marginEnd="@dimen/filter_card_margin"
        android:layout_marginBottom="4dp"
        android:minHeight="44dp"
        android:text="Journal Entry" />

    <include
        layout="@layout/include_report_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
