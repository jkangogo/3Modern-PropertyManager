<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".AddTenant">

    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_toolbar" android:minHeight="?attr/actionBarSize" android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <TextView android:id="@+id/toolbar_title" style="@style/Widget.PManager.ToolbarTitle" android:text="Add tenant" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <com.threemsystems.rentmanager.BoundedWidthLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boundedMaxWidth="@dimen/form_max_width">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
            <ProgressBar android:id="@+id/tenantaddprogress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminateTint="@color/teal_700" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/teal_wash" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Widget.PManager.FormCaption" android:layout_marginTop="0dp" android:text="Tenant type" />
                    <Spinner android:id="@+id/spnTenantTypeAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Property" />
                    <Spinner android:id="@+id/spnTenantPAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Unit" />
                    <Spinner android:id="@+id/spnTenantPUAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Unit rent">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTenantUNAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Water bill">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ettenantWaterAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Electric bill">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ettenantElecAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Service fee">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTenantSAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ID / Passport">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTenantIDAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Names">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTenantNameAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="PIN">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTenantpinAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Telephone">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ettenantTelAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Address">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ettenantAddAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Date from" />
                    <EditText android:id="@+id/dteTenantFrmAdd" style="@style/Widget.PManager.FilterField" android:drawableEnd="@drawable/ic_calendar" android:hint="Start date" />
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Status" />
                    <Spinner android:id="@+id/spnTenantStatusAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btTenantsubmit" style="@style/Widget.PManager.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnTenantclose" style="@style/Widget.PManager.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="Close" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnTenantreset" style="@style/Widget.PManager.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reset" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        </com.threemsystems.rentmanager.BoundedWidthLayout>
    </ScrollView>
</LinearLayout>
