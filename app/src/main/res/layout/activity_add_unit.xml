<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".AddUnit">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <TextView android:id="@+id/toolbar_title" style="@style/Widget.PManager.ToolbarTitle" android:text="Add unit" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <com.threemsystems.rentmanager.BoundedWidthLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boundedMaxWidth="@dimen/form_max_width">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
            <ProgressBar android:id="@+id/unitaddprogress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminateTint="@color/teal_700" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/teal_wash" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Widget.PManager.FormCaption" android:layout_marginTop="0dp" android:text="Property" />
                    <Spinner android:id="@+id/spnUnitPropertyAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Unit code">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitCodeAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Unit name">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitNameAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Description">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitDescAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Unit rent">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitRentAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Electricity meter">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitElectAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Electricity bill shared?" />
                    <Spinner android:id="@+id/spnUnitElectAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Water meter">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitWaterAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Water bill shared?" />
                    <Spinner android:id="@+id/spnUnitWaterSharedAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Service fee">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etUnitServiceAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnUnitsubmit" style="@style/Widget.PManager.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnUnitclose" style="@style/Widget.PManager.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="Close" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnUnitreset" style="@style/Widget.PManager.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reset" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        </com.threemsystems.rentmanager.BoundedWidthLayout>
    </ScrollView>
</LinearLayout>
