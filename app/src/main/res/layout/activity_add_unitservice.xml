<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".AddUnitService">

    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_toolbar" android:minHeight="?attr/actionBarSize" android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <TextView android:id="@+id/toolbar_title" style="@style/Widget.PManager.ToolbarTitle" android:text="Unit service" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <com.threemsystems.rentmanager.BoundedWidthLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boundedMaxWidth="@dimen/form_max_width">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
            <ProgressBar android:id="@+id/unitserviceaddprogress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminateTint="@color/teal_700" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeColor="@color/teal_wash" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Widget.PManager.FormCaption" android:layout_marginTop="0dp" android:text="Property" />
                    <Spinner android:id="@+id/spnUnitservicePAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Unit" />
                    <Spinner android:id="@+id/spnUnitservicePUAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Service type" />
                    <Spinner android:id="@+id/spServiveTypeAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Service month" />
                    <EditText android:id="@+id/ServiceMonthAdd" style="@style/Widget.PManager.FilterField" android:drawableEnd="@drawable/ic_calendar" android:hint="Select month" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Previous reading">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/previousread" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Current reading">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/currentRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Consumption">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConsumption" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Rate">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PManager.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Service cost">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etServiceCost" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView style="@style/Widget.PManager.FormCaption" android:text="Status" />
                    <Spinner android:id="@+id/spnServiceStatusAdd" style="@style/Widget.PManager.FilterSpinner" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btServicesubmit" style="@style/Widget.PManager.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnServiceclose" style="@style/Widget.PManager.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="Close" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnServicereset" style="@style/Widget.PManager.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reset" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        </com.threemsystems.rentmanager.BoundedWidthLayout>
    </ScrollView>
</LinearLayout>
