<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".Holder.MessageActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <TextView
            android:id="@+id/toolbar_title"
            style="@style/Widget.PManager.ToolbarTitle"
            android:text="Send a message" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <com.threemsystems.rentmanager.BoundedWidthLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boundedMaxWidth="@dimen/form_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/teal_wash"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Widget.PManager.FormCaption"
                        android:layout_marginTop="0dp"
                        android:text="Recipients" />

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="12dp"
                        android:text="Property" />

                    <Spinner
                        android:id="@+id/spnPropertysms"
                        style="@style/Widget.PManager.FilterSpinner" />

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="8dp"
                        android:text="Unit" />

                    <Spinner
                        android:id="@+id/spnUnitsms"
                        style="@style/Widget.PManager.FilterSpinner" />

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="8dp"
                        android:text="Tenant(s)" />

                    <Spinner
                        android:id="@+id/spnRecipient"
                        style="@style/Widget.PManager.FilterSpinner" />

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="8dp"
                        android:text="Month" />

                    <EditText
                        android:id="@+id/etsmsmonth"
                        style="@style/Widget.PManager.FilterField"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:hint="Invoice or payment month" />

                    <EditText
                        android:id="@+id/etRecipient"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:textColor="@color/black" />

                    <TextView
                        style="@style/Widget.PManager.FilterLabel"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="8dp"
                        android:text="SMS type" />

                    <Spinner
                        android:id="@+id/spMSGtype"
                        style="@style/Widget.PManager.FilterSpinner" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/teal_wash"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Widget.PManager.FormCaption"
                        android:layout_marginTop="0dp"
                        android:text="Message" />

                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="Write the SMS that tenants will receive"
                        android:inputType="textMultiLine"
                        android:lines="8"
                        android:maxLines="10"
                        android:minLines="6"
                        android:scrollbars="vertical"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/Widget.PManager.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Send SMS" />
        </LinearLayout>
        </com.threemsystems.rentmanager.BoundedWidthLayout>
    </ScrollView>
</LinearLayout>
