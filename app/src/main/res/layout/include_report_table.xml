<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reportScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="@dimen/report_min_width"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/reportHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_table_header"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/filter_card_padding"
            android:paddingEnd="@dimen/filter_card_padding" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/filter_card_padding"
            android:paddingEnd="@dimen/filter_card_padding"
            android:paddingBottom="@dimen/filter_card_padding"
            android:paddingTop="@dimen/filter_card_padding">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reportList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/reportEmpty"
                style="@style/Widget.PManager.EmptyState"
                android:layout_gravity="center"
                android:text="Nothing to show yet" />
        </FrameLayout>
    </LinearLayout>
</HorizontalScrollView>
